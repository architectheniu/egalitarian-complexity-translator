            }
          },
          "L2": {
            "title": "The VWinAt ψ 401 contract",
            "headline": "Inputs: Row0b + prime pairs; output: a window [Y, Y²] with the VAt bound for every admissible (q, d).",
            "explanation": "Contract: for every ε ∈ (0, 1/52) and every layer choice e(x) satisfying PageN, there exist J ≥ 1 and X0 such that for X ≥ X0 and every pair WinPair ε (X^(1/J)) q d there is a Y with X^(1/J) ≤ Y and Y² ≤ X for which VAt ψ ε 401 q d (e x) x holds on all of [Y, Y²]. VAt bounds twists below ⌊x^401⌋ by √exp(x^ε); the base measure is VVle, meaning finite lengths for 1 ≤ e < t and Σ log ℓ · Σ_e length ≤ B. The producer vwin_of_row routes Row0b through OpenImageCondition, baseChangeN and RowT into the rank-N package.",
            "key_insight": "A single Row0b term is enough to produce the whole window contract; the remaining inputs come from literature records.",
            "analogy_anchor": "A service SLA: for every quality level ε the provider guarantees a fixed-shape time window [Y, Y²] in which the error cap holds.",
            "loss_meter": {
              "fidelity_score": 0.7,
              "compression_ratio": "~5,000:1",
              "topology_status": "faithful_projection",
              "what_is_omitted": [
