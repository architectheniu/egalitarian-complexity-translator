        "id": "bundle-zeta",
        "component": "reflection",
        "section": "reductions",
        "kind": "reducer",
        "title": "Zeta component of the conjunction",
        "contract": "Claim.HalfPlane implies Claim.Zeta.",
        "idea": "Use strip at modulus one in the interior, established nonvanishing for Re(s)≥1, and completed zeta symmetry on the left.",
        "assumptions": [
