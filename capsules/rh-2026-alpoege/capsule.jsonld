      "comparison": {
        "en": {
          "L0": {
            "title": "The Prism That Translates Shapes into Primes",
            "headline": "If the points on a shape are spread evenly enough, then the prime-drum wobble must be small.",
            "explanation": "Picture a prism that splits white light into colours and a second prism that puts the colours back together without losing any light. This part of the machine uses the same trick on a finite set of 'colours' to turn one scoreboard, which records how evenly points are spread on a geometric shape, into another, the prime noise meter. The main parts of the two scoreboards match exactly, so only their errors are compared. The arrow runs one way: a good spread goes in, and a quiet prime meter comes out.",
            "key_insight": "Splitting into colours and adding them back loses nothing, so a geometric guarantee can be carried over unchanged into a guarantee about primes.",
            "analogy_anchor": "Two glass prisms: one splits the light, the other rebuilds it exactly",
            "loss_meter": {
              "fidelity_score": 0.2,
              "compression_ratio": "~500,000:1",
              "topology_status": "lossy_analogy",
              "what_is_omitted": [
                "Finite Fourier analysis on an abelian group and on its subgroup A0",
                "The exact main-term identity ASK − Main = gapA",
                "The loss budget in the exponent 1/2 + (eD+eL+7)ε",
                "The window and size conditions (b, k, m, aE, the scales X′ and θ)"
              ],
              "where_metaphor_breaks": "A real prism works on continuous light. Here the 'colours' are a finite set of additive characters, and some losses do occur: they are paid in powers x^ε, so the transfer is not perfectly lossless."
            }
          },
          "L1": {
            "title": "Converting a Discrepancy Budget into a Prime Budget",
            "headline": "Main terms match exactly, gaps are averaged by orthogonality, and every loss is paid in the exponent.",
            "explanation": "An exact main-term identity makes the per-index gap equal to the difference between the observed value and the main term, so only the geometric error is compared. Character orthogonality averages those per-index gaps into a weighted average, and the factor that depends on the level is absorbed into one extra x^ε. The losses add up linearly in the exponent to 1/2 + (eD+eL+7)ε; with the family's inputs eD = 2 and eL = 0 this becomes 1/2 + 9ε.",
            "key_insight": "The bottleneck is additive bookkeeping: every input loss raises the exponent above 1/2 by a fixed multiple of ε, and nothing more.",
            "analogy_anchor": "An exchange office that converts geometric currency into prime currency at a fixed commission, with every fee written into the exponent",
            "loss_meter": {
              "fidelity_score": 0.45,
              "compression_ratio": "~50,000:1",
              "topology_status": "faithful_projection",
              "what_is_omitted": [
                "The predicates EAtH and CoreAtH and the 'tied' structure of families",
