        "en": {
          "L0": {
            "title": "A quiet room means there is no drum",
            "headline": "If the room is always quiet late at night, nobody is playing a big drum in there.",
            "explanation": "A hidden drum, if it existed, would get louder and louder over time, and its booming would eventually have to come through the walls. So if every time we listen very late — and for a good long while — the noise stays below a certain level, such a loud drum is not there. We do not have to listen all night; ever-later, long-enough windows of quiet are enough.",
            "key_insight": "Checking for quiet in ever-later windows is enough to rule out a hidden loud source.",
            "analogy_anchor": "Listening for a drum through the wall late at night.",
            "loss_meter": {
              "fidelity_score": 0.2,
              "compression_ratio": "~500,000:1",
              "topology_status": "lossy_analogy",
              "what_is_omitted": [
                "The windows [Y, Y^{1+δ}] and the bound C·y^θ on the prime sum",
