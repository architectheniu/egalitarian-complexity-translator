      {
        "id": "reflection",
        "n": 2,
        "stratum": "dest",
        "title_raw": "Reflection",
        "kicker": "functional equations",
        "gist_raw": "A zero left of the critical line reflects to a zero right of it, so the right half-plane is all one has to clear.",
        "node_count": 8,
        "node_ids": [
          "rh-every",
          "rh-right",
