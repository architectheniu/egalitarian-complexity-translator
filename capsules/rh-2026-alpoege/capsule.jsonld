        "lean_head": "lemma noRel_image (L S d k : ℕ) (hL : 1 ≤ L) :\n    NoRel ((Behrend.sphere S d k).image (Behrend.map (4 * L * d))) L",
        "declaration": "Formalism.FrobeniusOrbits.ThickExists.noRel_image",
