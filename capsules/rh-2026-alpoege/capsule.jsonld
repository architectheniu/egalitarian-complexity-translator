        "component": "reflection",
        "section": "reductions",
        "kind": "reducer",
        "title": "Specialize at modulus one",
        "contract": "EveryCharacter implies RiemannHypothesis.",
        "idea": "At modulus one the Dirichlet L-function equals zeta. Supply its right-half-plane nonvanishing to rh_of_right.",
