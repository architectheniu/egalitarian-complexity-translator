        "lean_head": "theorem factor_ne_zero {M : ℕ} (ψ : DirichletCharacter ℂ M) {s : ℂ} (hs : 0 < s.re) (p : ℕ)\n    (hp : p.Prime) : (1 : ℂ) - ψ p * (p : ℂ) ^ (-s) ≠ 0",
        "declaration": "Claim.factor_ne_zero",
        "module": "Development.AutomorphicArithmetic.CharacterBoxes.ClaimStrip",
        "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Development/AutomorphicArithmetic/CharacterBoxes/ClaimStrip.lean#L7-L21",
        "excerpt": "theorem factor_ne_zero {M : ℕ} (ψ : DirichletCharacter ℂ M) {s : ℂ} (hs : 0 < s.re) (p : ℕ)\n    (hp : p.Prime) : (1 : ℂ) - ψ p * (p : ℂ) ^ (-s) ≠ 0 := by\n  intro h\n  have h1 : ψ p * (p : ℂ) ^ (-s) = 1 := by linear_combination -h\n  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt\n  have hpow : ‖(p : ℂ) ^ (-s)‖ < 1 := by\n    rw [Complex.norm_natCast_cpow_of_pos hp.pos, Complex.neg_re]\n    exact Real.rpow_lt_one_of_one_lt_of_neg hp1 (by linarith)\n  have hn : ‖ψ p * (p : ℂ) ^ (-s)‖ < 1 := by\n    rw [norm_mul]\n    calc ‖ψ p‖ * ‖(p : ℂ) ^ (-s)‖ ≤ 1 * ‖(p : ℂ) ^ (-s)‖ := by\n          gcongr; exact ψ.norm_le_one _\n      _ < 1 := by rw [one_mul]; exact hpow\n  rw [h1, norm_one] at hn\n  exact lt_irrefl _ hn",
