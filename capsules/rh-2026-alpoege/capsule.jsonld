    "strata": [
      {
        "id": "arith",
        "order": 0,
        "color": "#c2410c",
        "title_raw": "Arithmetic supply",
        "blurb_raw": "Galois representations, theta lifts and Iwasawa-type cohomology bounds that are meant to produce the families on which a prime sum is small."
      },
      {
        "id": "est",
        "order": 1,
        "color": "#7c3aed",
        "title_raw": "The estimate",
        "blurb_raw": "A finite character comparison turns geometric control of a chain of theta lifts of length about √x into an upper bound for a weighted prime sum."
      },
      {
        "id": "ana",
        "order": 2,
        "color": "#0891b2",
        "title_raw": "The analytic engine",
        "blurb_raw": "A localized Landau oscillation argument converts one-sided bounds on whole power windows into a zero-free half-plane."
      },
      {
        "id": "dest",
        "order": 3,
        "color": "#e11d48",
        "title_raw": "The destination",
        "blurb_raw": "Euler factors, conductors and functional equations turn the half-plane theorem into the five exported statements, including Mathlib's RiemannHypothesis."
      }
