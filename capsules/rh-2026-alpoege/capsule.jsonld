      "galois": {
        "en": {
          "L0": {
            "title": "The Twin Song Made of Crystal Turns",
            "headline": "Every special hidden melody gets a twin, written in a completely different language, that sings the same chord at every door.",
            "explanation": "Picture a secret melody played in an unusual concert hall. This part of the machine promises that the melody always has a twin, made from the turns of a crystal instead of from sound, and that at every numbered door the two of them strike exactly the same chord. To build the twin, the machine borrows a much bigger choir and starts from a very simple seed song. The twin is then handed to two later workshops.",
            "key_insight": "Two very different worlds, sound and crystal turns, turn out to carry the same fingerprint at every door. Here, finding that twin is a borrowed promise. It is not built from scratch.",
            "analogy_anchor": "A song and its sheet music in a foreign alphabet that always agree note for note, whichever page you open.",
            "loss_meter": {
              "fidelity_score": 0.2,
              "compression_ratio": "~500,000:1",
              "topology_status": "lossy_analogy",
              "what_is_omitted": [
