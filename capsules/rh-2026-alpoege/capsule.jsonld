      {
        "id": "landau",
        "component": "criterion",
        "section": "windows",
        "kind": "reducer",
        "title": "The character-family power-window theorem",
        "contract": "For a positive-weight family, a one-sided x^θ bound on arbitrarily late [Y,Y^(1+δ)] implies ZeroFree F θ.",
        "idea": "Pass to the weighted-integral formulation of the Landau window criterion.",
        "assumptions": [
          "0<θ<1, δ>0",
          "∀ Y₀, ∃ Y≥Y₀, ∀ y∈[Y,Y^(1+δ)], Gm F y≤C y^θ"
        ],
        "lean_head": "theorem zeroFree_of_rpow_window (F : CharFamily) {θ δ C : ℝ} (hθ : 0 < θ) (hθ1 : θ < 1) (hδ : 0 < δ)\n    (h : ∀ Y₀ : ℝ, ∃ Y : ℝ, Y₀ ≤ Y ∧ ∀ y ∈ Set.Icc Y (Y ^ (1 + δ)), Gm F y ≤ C * y ^ θ) :\n    ZeroFree F θ",
        "declaration": "Deduction.zeroFree_of_rpow_window",
