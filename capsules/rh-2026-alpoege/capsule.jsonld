          {
            "id": "stmt-zeta",
            "declaration": "RiemannZetaZerosOnLine",
            "module": "Statements",
            "lines": [
              3,
              4
            ],
            "kind": "definition",
            "tier": "read",
            "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Statements.lean#L3-L4",
            "excerpt": "def RiemannZetaZerosOnLine : Prop :=\n  ∀ s : ℂ, riemannZeta s = 0 → (¬∃ n : ℕ, s = -2 * ((n : ℂ) + 1)) → s ≠ 1 → s.re = 1 / 2"
          },
          {
            "id": "stmt-right",
            "declaration": "DirichletLNonvanishingRightOfHalf",
            "module": "Statements",
            "lines": [
              6,
              8
            ],
            "kind": "definition",
            "tier": "read",
            "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Statements.lean#L6-L8",
            "excerpt": "def DirichletLNonvanishingRightOfHalf : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),\n    1 / 2 < s.re → (χ ≠ 1 ∨ s ≠ 1) → DirichletCharacter.LFunction χ s ≠ 0"
          },
          {
            "id": "stmt-strip",
            "declaration": "DirichletLZerosOnLine",
            "module": "Statements",
            "lines": [
              10,
              12
            ],
            "kind": "definition",
            "tier": "read",
            "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Statements.lean#L10-L12",
            "excerpt": "def DirichletLZerosOnLine : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),\n    0 < s.re → s.re < 1 → DirichletCharacter.LFunction χ s = 0 → s.re = 1 / 2"
          }
