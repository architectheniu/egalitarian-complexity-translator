    "audit": [
      {
        "node": "main-rh",
        "title": "Exact endpoint replay",
        "acceptance": "Compile the five unmodified exports at the archive pins, verify their exact types, inspect their transitive axioms, and replay the selected kernel checker."
      },
      {
        "node": "window-consumer",
        "title": "Separate the analytic implication",
        "acceptance": "Trace the finite positive-weight character family through poleData, landau_window and the uniform window bound. Check the pole treatment and the order of quantifiers."
      },
      {
        "node": "definite",
        "title": "Nonempty compatible data",
        "acceptance": "Follow the witnesses for the same geometric family through the test-vector grids, linked bundles and nonempty definite-side hypotheses."
      },
      {
        "node": "row-prod",
        "title": "Source comparison of the Galois input",
        "acceptance": "Unfold the row, the local-normalization convention and the theta-lift producer together. Check all quantified places, twists and weight restrictions."
      },
      {
        "node": "four-use",
        "title": "Uniform cohomological bound",
        "acceptance": "Track finiteness and the absolute constants from the four counting cases to the finite prime sums on the claimed windows."
      }
    ],
    "challenge_statements": {
      "Challenge.lean": "import Mathlib\n\ndef RiemannZetaZerosOnLine : Prop :=\n  ∀ s : ℂ, riemannZeta s = 0 → (¬∃ n : ℕ, s = -2 * ((n : ℂ) + 1)) → s ≠ 1 → s.re = 1 / 2\n\ndef DirichletLNonvanishingRightOfHalf : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),\n    1 / 2 < s.re → (χ ≠ 1 ∨ s ≠ 1) → DirichletCharacter.LFunction χ s ≠ 0\n\ndef DirichletLZerosOnLine : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),\n    0 < s.re → s.re < 1 → DirichletCharacter.LFunction χ s = 0 → s.re = 1 / 2\n\ndef PrimitiveDirichletLZerosOnLine : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N), χ.IsPrimitive →\n    ∀ s : ℂ, 0 < s.re → s.re < 1 → DirichletCharacter.LFunction χ s = 0 → s.re = 1 / 2\n\n/-- The headline claim, stated with Mathlib's definition only. -/\ntheorem riemannHypothesis : RiemannHypothesis := by sorry\n\ntheorem riemannZeta_eq_zero_re : RiemannZetaZerosOnLine := by sorry\n\ntheorem LFunction_ne_zero_of_half_lt_re : DirichletLNonvanishingRightOfHalf := by sorry\n\ntheorem LFunction_eq_zero_re : DirichletLZerosOnLine := by sorry\n\ntheorem LFunction_eq_zero_re_of_isPrimitive : PrimitiveDirichletLZerosOnLine := by sorry\n",
      "Main.lean": "import Statements\nimport Supplements.Kernels.MainTheorems\n\ntheorem riemannHypothesis : RiemannHypothesis := rhOfAll\n\ntheorem riemannZeta_eq_zero_re : RiemannZetaZerosOnLine := rhOfAll\n\ntheorem LFunction_ne_zero_of_half_lt_re : DirichletLNonvanishingRightOfHalf := allChi\n\ntheorem LFunction_eq_zero_re : DirichletLZerosOnLine := claimAll.2.1\n\ntheorem LFunction_eq_zero_re_of_isPrimitive : PrimitiveDirichletLZerosOnLine := critAll\n",
      "Statements.lean": "import Mathlib.NumberTheory.LSeries.DirichletContinuation\n\ndef RiemannZetaZerosOnLine : Prop :=\n  ∀ s : ℂ, riemannZeta s = 0 → (¬∃ n : ℕ, s = -2 * ((n : ℂ) + 1)) → s ≠ 1 → s.re = 1 / 2\n\ndef DirichletLNonvanishingRightOfHalf : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),\n    1 / 2 < s.re → (χ ≠ 1 ∨ s ≠ 1) → DirichletCharacter.LFunction χ s ≠ 0\n\ndef DirichletLZerosOnLine : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),\n    0 < s.re → s.re < 1 → DirichletCharacter.LFunction χ s = 0 → s.re = 1 / 2\n\ndef PrimitiveDirichletLZerosOnLine : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N), χ.IsPrimitive →\n    ∀ s : ℂ, 0 < s.re → s.re < 1 → DirichletCharacter.LFunction χ s = 0 → s.re = 1 / 2\n"
    }
  },
