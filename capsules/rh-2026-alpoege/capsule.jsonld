        "section": "reductions",
        "kind": "reducer",
        "title": "Reflect a primitive character",
        "contract": "EveryCharacter implies the primitive open-strip conclusion.",
        "idea": "The completed functional equation reflects the zero to the inverse character at 1−s.",
        "assumptions": [
          "EveryCharacter",
          "positive modulus, primitive χ",
          "0<Re(s)<1, L(s,χ)=0"
        ],
        "lean_head": "theorem Formalism.VW.critLine (h : UpperTheory.EveryCharacter) (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (hχ : χ.IsPrimitive) (s : ℂ)\n    (h0 : 0 < s.re) (h1 : s.re < 1) (hz : LFunction χ s = 0) : s.re = 1 / 2",
        "declaration": "Formalism.VW.critLine",
        "module": "Formalism.GammaFactorNonvanishing.CritLine",
        "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Formalism/GammaFactorNonvanishing/CritLine.lean#L11-L27",
        "excerpt": "theorem Formalism.VW.critLine (h : UpperTheory.EveryCharacter) (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (hχ : χ.IsPrimitive) (s : ℂ)\n    (h0 : 0 < s.re) (h1 : s.re < 1) (hz : LFunction χ s = 0) : s.re = 1 / 2 := by\n  have hs0 : s ≠ 0 := fun e => by simp [e] at h0\n  have hs1 : s ≠ 1 := fun e => by simp [e] at h1\n  by_contra hne\n  rcases lt_or_gt_of_ne hne with hlt | hgt\n  · have hinv : χ⁻¹.IsPrimitive := by\n      rw [isPrimitive_def, conductor_inv]; exact hχ\n    have hc : completedLFunction χ s = 0 := by\n      rw [LFunction_eq_completed_div_gammaFactor χ s (Or.inl hs0)] at hz\n      exact (div_eq_zero_iff.1 hz).resolve_right (Formalism.VW.gammaFactor_ne_zero χ h0)\n    have hfe := hinv.completedLFunction_one_sub s\n    rw [inv_inv, hc, mul_zero] at hfe\n    have h2 : (1 - s) ≠ 0 := sub_ne_zero.2 hs1.symm\n    refine h N χ⁻¹ (1 - s) (by rw [sub_re, one_re]; linarith) (Or.inr fun e => hs0 (by linear_combination -e)) ?_\n    rw [LFunction_eq_completed_div_gammaFactor χ⁻¹ (1 - s) (Or.inl h2), hfe, zero_div]\n  · exact h N χ s hgt (Or.inr hs1) hz",
