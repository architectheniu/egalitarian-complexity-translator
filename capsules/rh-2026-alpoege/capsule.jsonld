        "id": "core-gm",
        "component": "comparison",
        "section": "windows",
        "kind": "reducer",
        "title": "From the height discrepancy to the prime sum",
        "contract": "For large x, EAtH and CoreAtH imply G_P(x)≤x^(1/2+(eD+eL+7)ε).",
        "idea": "Bound the per-index discrepancy, average via the character estimate and absorb the level-dependent factor into x^ε.",
