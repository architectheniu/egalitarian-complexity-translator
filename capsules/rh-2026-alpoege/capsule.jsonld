      "hosts": {
        "en": {
          "L0": {
            "title": "A Concert Hall for Every Tune",
            "headline": "Whatever tune you pick, far enough down the road there is always a hall of the right width to play it in.",
            "explanation": "Think of every possible tune as a guest that needs a concert hall. A special window, opened earlier by another team, lets light into the tune; once that window is open, you are promised that, far enough along the road, every town has a hall of the same fixed width ready for that tune. These halls are then handed to the next team, which compares how the tunes sound.",
            "key_insight": "The open window comes first; the halls follow from it, for every tune and every far-away town.",
            "analogy_anchor": "Concert halls of one fixed width waiting in every distant town for each tune.",
            "loss_meter": {
              "fidelity_score": 0.2,
              "compression_ratio": "~500,000:1",
              "topology_status": "lossy_analogy",
