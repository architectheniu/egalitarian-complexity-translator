      "family": {
        "en": {
          "L0": {
            "title": "The Tuned Staircase of Bells",
            "headline": "A long, carefully built staircase of bells where each leak is set before the concert starts.",
            "explanation": "Imagine building a very long staircase of bells, each new bell lifted from the one below it. Every bell is checked so that it rings cleanly, does not lean too much, and stands on a floor of the right size. Because every bell passes these checks, the builders know in advance that one kind of sound leak costs exactly two notches and the other costs none, and they hand this fixed budget to the next team.",
            "key_insight": "Picking the whole staircase on purpose turns two unknown leaks into two fixed numbers.",
            "analogy_anchor": "A staircase of bells, each lifted from the one before and checked for clean ringing, tilt and floor size.",
            "loss_meter": {
              "fidelity_score": 0.2,
              "compression_ratio": "~500,000:1",
              "topology_status": "lossy_analogy",
              "what_is_omitted": [
                "The actual objects: theta lifts, divisibility of minors, cohomology sums and rank windows",
                "The fact that the chain has about the square root of x steps and that its sizes grow with x",
                "The role of the small parameter epsilon and the shared threshold below which everything holds",
                "The hypotheses Green and the definite-side data that the construction needs"
              ],
              "where_metaphor_breaks": "Real bells exist one by one; here the whole family is a mathematical object whose existence is proved, and the two 'leaks' are exponents in an analytic estimate, not sounds."
            }
          },
          "L1": {
            "title": "Freezing the Loss Budget",
            "headline": "Choose the family so carefully that both loss exponents stop being variables and become constants.",
            "explanation": "The construction faces a tension: a richer family of theta lifts gives more signal, but every extra lift risks more loss through divisibility, slope and covolume defects. By imposing all controls at once and taking one common smallness threshold for the parameter, the family is built so that the divisibility loss is pinned at 2 and the second loss at 0. That frozen budget, not the family itself, is what flows downstream to the comparison step.",
            "key_insight": "The bottleneck is not finding a family but finding one in which every control holds simultaneously below a single shared threshold.",
            "analogy_anchor": "An engineer fixing two tolerances in advance so the next stage can rely on them as constants.",
            "loss_meter": {
              "fidelity_score": 0.45,
              "compression_ratio": "~50,000:1",
              "topology_status": "faithful_projection",
              "what_is_omitted": [
                "The explicit size windows for the ranks n, m, k and the linear relation for r and t",
                "The modular divisibility argument for minors (the w with w squared equal to p)",
                "The weighted cohomology (Sha-length) sum and how log squared of x is absorbed",
                "The many individual link conditions (LinkN, LinkEta, LinkIRR, LinkG, LinkS, LinkGLOBAL)"
              ],
              "where_metaphor_breaks": "Tolerances in engineering are measured after the fact; here the exponents eD = 2 and eL = 0 are fed into the existence theorem as parameters, and the proof shows they are achievable, not merely observed."
            }
          },
          "L2": {
            "title": "Family Design Contract",
            "headline": "Inputs: Green plus definite-side records. Output: TopG with eD = 2, eL = 0.",
