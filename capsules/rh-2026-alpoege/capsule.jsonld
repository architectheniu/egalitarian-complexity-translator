    "strata": {
      "arith": {
        "pl": {
          "L0": {
            "title": "Kuźnia instrumentów",
            "summary": "Najpierw ktoś musi zbudować całą orkiestrę instrumentów, które grają prawie bezgłośnie, gdy przechodzą przez nie liczby pierwsze."
          },
          "L1": {
            "title": "Źródło tłumiących rodzin",
            "summary": "Ta warstwa dostarcza surowiec: całe rodziny obiektów, w których sygnał liczb pierwszych się znosi. Bez tej dostawy dalsze piętra nie mają czego mierzyć."
          },
          "L2": {
            "title": "Moduł podaży arytmetycznej",
            "summary": "Wejście: reprezentacje Galois i podniesienia theta. Wyjście: rodziny z kohomologicznymi ograniczeniami typu Iwasawy, które gwarantują małość sumy po liczbach pierwszych w następnej warstwie."
          },
          "L3": {
            "title": "Reprezentacje Galois, podniesienia theta, kohomologia Iwasawy",
            "summary": "Reprezentacje Galois i łańcuchy podniesień theta, kontrolowane oszacowaniami kohomologii typu Iwasawy, mają wytworzyć rodziny automorficzne, na których ważona suma po liczbach pierwszych jest mała."
          },
          "L4": {
            "title": "Stratum `arith` (order 0)",
            "summary": "Węzły i krawędzie stratum `arith` są przypięte w formal_core_ir; obowiązują wyłącznie tamtejsze identyfikatory, pinezki i epistemic_status, a ta soczewka niczego do nich nie dodaje."
          }
        },
        "en": {
          "L0": {
            "title": "The instrument forge",
            "summary": "First someone has to build a whole orchestra of instruments that play almost silently whenever prime numbers pass through them."
          },
          "L1": {
            "title": "Source of quieting families",
            "summary": "This layer supplies the raw material: whole families of objects in which the prime signal cancels out. Without that supply, the floors above have nothing to measure."
          },
          "L2": {
            "title": "Arithmetic supply module",
            "summary": "Input: Galois representations and theta lifts. Output: families with Iwasawa-type cohomology bounds that make the prime sum small for the next layer."
          },
          "L3": {
            "title": "Galois representations, theta lifts, Iwasawa cohomology",
            "summary": "Galois representations and chains of theta lifts, controlled by Iwasawa-type cohomology bounds, are meant to produce automorphic families on which a weighted prime sum is small."
          },
          "L4": {
            "title": "Stratum `arith` (order 0)",
            "summary": "The nodes and edges of stratum `arith` are pinned in formal_core_ir. Only the identifiers, pins and epistemic_status recorded there count; this lens adds nothing to them."
          }
        }
      },
      "est": {
        "pl": {
          "L0": {
            "title": "Ważenie hałasu",
            "summary": "Ustawiamy długi rząd instrumentów jeden za drugim i porównując ich nuty, sprawdzamy, że szum liczb pierwszych nie może być głośniejszy niż pewna granica."
          },
          "L1": {
            "title": "Sufit nad hałasem",
            "summary": "Kontrolę geometrii zamienia się tu na twardy sufit: ważona suma po liczbach pierwszych nie może go przebić. Działa tylko w jedną stronę, bo ogranicza od góry."
          },
          "L2": {
            "title": "Moduł oszacowania",
            "summary": "Skończone porównanie charakterów przyjmuje łańcuch podniesień theta długości około √x i zwraca górne ograniczenie ważonej sumy po liczbach pierwszych. Długość łańcucha rośnie z x jak √x."
          },
          "L3": {
            "title": "Porównanie charakterów dla łańcucha długości ~√x",
            "summary": "Skończone porównanie charakterów przekłada kontrolę geometryczną łańcucha podniesień theta długości rzędu √x na jednostronne górne oszacowanie ważonej sumy po liczbach pierwszych."
          },
          "L4": {
            "title": "Stratum `est` (order 1)",
            "summary": "Twierdzenie oszacowania i jego zależności od `arith` są przypięte w formal_core_ir. Status epistemiczny, w tym ewentualne otwarte założenia, odczytuje się stamtąd, a nie z tej soczewki."
          }
        },
        "en": {
          "L0": {
            "title": "Weighing the noise",
            "summary": "We line up a long row of instruments one after another and compare their notes to show that the noise of the primes cannot get louder than a certain limit."
          },
          "L1": {
            "title": "A ceiling over the noise",
            "summary": "Here geometric control becomes a hard ceiling that the weighted prime sum cannot break through. It works in one direction only and bounds from above."
          },
          "L2": {
            "title": "Estimate module",
            "summary": "A finite character comparison takes a chain of theta lifts of length about √x and returns an upper bound for a weighted prime sum. The chain length grows with x like √x."
          },
          "L3": {
            "title": "Character comparison over a ~√x theta chain",
            "summary": "A finite character comparison turns geometric control of a chain of theta lifts of length on the order of √x into a one-sided upper bound for a weighted prime sum."
          },
          "L4": {
            "title": "Stratum `est` (order 1)",
            "summary": "The estimate theorem and its dependencies on `arith` are pinned in formal_core_ir. Epistemic status, including any open assumptions, is read from there, not from this lens."
          }
        }
      },
      "ana": {
        "pl": {
          "L0": {
            "title": "Silnik, który słyszy echo",
            "summary": "Jeśli żadne okno w domu nigdy nie dudni za głośno, silnik dowodzi, że w całej połowie domu nie może ukrywać się żaden ukryty dzwon."
          },
          "L1": {
            "title": "Z sufitu na wolną strefę",
            "summary": "Jednostronne sufity nałożone na całe okna potęgowe wystarczą, by wykluczyć zera w pełnej półpłaszczyźnie. Ukryte zero wywołałoby drgania, które przebiłyby sufit."
          },
          "L2": {
            "title": "Silnik analityczny",
            "summary": "Wejście: jednostronne ograniczenia na całych oknach potęgowych. Wyjście: półpłaszczyzna wolna od zer, uzyskana lokalizowanym argumentem oscylacyjnym Landaua."
          },
          "L3": {
            "title": "Zlokalizowana oscylacja Landaua",
            "summary": "Zlokalizowany argument oscylacyjny typu Landaua zamienia jednostronne oszacowania na całych oknach potęgowych w półpłaszczyznę wolną od zer odpowiednich funkcji L."
          },
          "L4": {
            "title": "Stratum `ana` (order 2)",
            "summary": "Twierdzenie o półpłaszczyźnie bez zer i jego zależność od `est` są przypięte w formal_core_ir. Kierunek grafu `est -> ana` jest nienaruszalny."
          }
        },
        "en": {
          "L0": {
            "title": "The engine that hears echoes",
            "summary": "If no window in the house ever rattles too loudly, the engine proves that no hidden bell can be lurking anywhere in half of the house."
          },
          "L1": {
            "title": "From ceiling to free zone",
            "summary": "One-sided ceilings over whole power windows are enough to rule out zeros in an entire half-plane. A hidden zero would cause oscillations that break the ceiling."
          },
          "L2": {
            "title": "Analytic engine",
            "summary": "Input: one-sided bounds on whole power windows. Output: a zero-free half-plane, obtained by a localized Landau oscillation argument."
          },
          "L3": {
            "title": "Localized Landau oscillation",
            "summary": "A localized Landau-type oscillation argument converts one-sided bounds on whole power windows into a zero-free half-plane for the relevant L-functions."
          },
          "L4": {
            "title": "Stratum `ana` (order 2)",
            "summary": "The zero-free half-plane theorem and its dependency on `est` are pinned in formal_core_ir. The graph direction `est -> ana` is fixed."
          }
        }
      },
      "dest": {
        "pl": {
          "L0": {
            "title": "Meta",
            "summary": "Na końcu odbijamy pół domu w lustrze. Skoro w żadnej połowie nie ma dzwonów, wszystkie prawdziwe dzwony stoją dokładnie na środkowej linii."
          },
          "L1": {
            "title": "Lustro symetrii",
            "summary": "Symetria równania funkcyjnego odbija wolną półpłaszczyznę na drugą stronę, więc zera zostają ściśnięte na jednej prostej. Stąd biorą się końcowe twierdzenia."
          },
          "L2": {
            "title": "Moduł eksportu",
            "summary": "Czynniki Eulera, konduktory i równania funkcyjne przenoszą twierdzenie o półpłaszczyźnie na pięć eksportowanych twierdzeń. Jednym z nich jest `RiemannHypothesis` z Mathlib."
          },
          "L3": {
            "title": "Czynniki Eulera, konduktory, równanie funkcyjne",
            "summary": "Kontrola czynników Eulera i konduktorów wraz z równaniem funkcyjnym przenosi półpłaszczyznę bez zer na pięć eksportowanych tez, w tym hipotezę Riemanna w sformułowaniu Mathlib."
          },
          "L4": {
            "title": "Stratum `dest` (order 3)",
            "summary": "Pięć eksportowanych twierdzeń, w tym `RiemannHypothesis` z Mathlib, jest przypiętych w formal_core_ir. Sprawdzenie maszynowe i powtórka w jądrze to nie to samo co recenzja matematyczna przez ludzi; status każdego z nich podaje epistemic_status."
          }
        },
        "en": {
          "L0": {
            "title": "The finish line",
            "summary": "At the end we reflect half of the house in a mirror. Since neither half hides any bells, all the real bells stand exactly on the middle line."
          },
          "L1": {
            "title": "The symmetry mirror",
            "summary": "The symmetry of the functional equation reflects the free half-plane across, squeezing the zeros onto a single line. The final theorems come from that squeeze."
          },
          "L2": {
            "title": "Export module",
            "summary": "Euler factors, conductors and functional equations carry the half-plane theorem over to the five exported statements. One of them is Mathlib's `RiemannHypothesis`."
          },
          "L3": {
            "title": "Euler factors, conductors, functional equation",
            "summary": "Control of Euler factors and conductors, together with the functional equation, carries the zero-free half-plane over to five exported statements, including the Riemann Hypothesis as formulated in Mathlib."
          },
          "L4": {
            "title": "Stratum `dest` (order 3)",
            "summary": "The five exported statements, including Mathlib's `RiemannHypothesis`, are pinned in formal_core_ir. Machine-checked compilation and kernel replay are not the same as human mathematical peer review; epistemic_status gives the status of each."
          }
        }
      }
    },
    "components": {
      "primes": {
        "en": {
          "L0": {
            "title": "Two Helper Keys and the No-Echo Marbles",
            "headline": "Before the big machine starts, we pick two special keys and a handful of marbles that can never line up three in a row.",
            "explanation": "First we look for two special numbers. They work like tuning keys: each one has to sit on exactly the right note, and the hum it makes has to stay quiet instead of building into a roar. Then we pick marbles from the skin of a ball, because a straight stick can touch a ball's skin in at most two places, so no three marbles ever fall in one line. Both the keys and the marbles get handed downstream to a later workshop.",
            "key_insight": "A ball is round, so three different points on its skin can never lie on one straight line. That roundness is what makes the marble choice safe.",
            "analogy_anchor": "Marbles glued onto a beach ball. You poke a straight knitting needle through the ball and it always hits at most two of them.",
            "loss_meter": {
              "fidelity_score": 0.2,
              "compression_ratio": "~500,000:1",
              "topology_status": "lossy_analogy",
              "what_is_omitted": [
                "That the helper 'keys' are prime numbers in prescribed congruence classes",
                "The square-root-size bounds on prime sums of their quadratic twists",
                "The base-4Ld number encoding that turns sphere points into single integers",
                "The exact meaning of 'no three in a line' (the NoRel predicate with coefficients bounded by L)"
              ],
              "where_metaphor_breaks": "Real marbles sit in physical space. The real objects are whole numbers, and 'lining up' means satisfying a weighted equation with small whole-number weights, not touching a needle."
            }
          },
          "L1": {
            "title": "Tuned Probes and a Collision-Free Index Set",
            "headline": "Two probe primes with controlled noise, plus an index tower designed so that no small weighted coincidence can occur.",
            "explanation": "The arithmetic layer prepares two kinds of raw material. The first is a pair of auxiliary primes fixed to prescribed residues, whose quadratic twists produce prime sums no larger than square-root size, so they behave like noise rather than signal. The second is a Behrend-type tower: points on a sphere, written as single integers in a base so large that adding them never causes carries, so any coincidence among the integers would have to be a coincidence among the sphere points, and a sphere's curvature rules that out for three distinct points.",
            "key_insight": "The large base keeps the digits from mixing, so each equation splits into one equation per coordinate. Curvature does the rest: a line meets a sphere in at most two points.",
            "analogy_anchor": "An odometer with enormously wide digit wheels, so no wheel ever rolls over into its neighbour, reading off points on a perfectly round globe.",
            "loss_meter": {
              "fidelity_score": 0.45,
              "compression_ratio": "~50,000:1",
              "topology_status": "faithful_projection",
              "what_is_omitted": [
                "The precise form of the NoRel predicate (distinct s₁, s₂, s₃ and weights i, j in [1, L])",
                "The roles of the parameters S, d, k in Behrend.sphere",
                "The exact congruence conditions and the analytic form of the square-root prime-sum bound",
                "How downstream cohomology consumes the pair and the tower (WinPair / hostThickExists)"
              ],
              "where_metaphor_breaks": "'Noise versus signal' is only an intuition. Formally the prime-pair condition is a specific inequality on twisted prime sums, and 'no coincidence' is the exact Lean predicate NoRel, not a statistical property."
            }
          },
          "L2": {
            "title": "Contract: NoRel Image of an Encoded Sphere + Auxiliary Prime Pair",
            "headline": "Input (L ≥ 1, S, d, k). Output: a finite set of naturals satisfying NoRel at coefficient bound L, delivered with a prime pair to cohomology.",
            "explanation": "The checked contract `noRel_image` takes L ≥ 1 and sphere parameters (S, d, k), maps Behrend.sphere S d k through Behrend.map (4·L·d), and guarantees NoRel(·, L) for the image. The base 4Ld depends on L, so the coefficient bound has to be fixed before the encoding is chosen. The second output is an auxiliary prime pair with prescribed congruences and square-root (exponent ½) prime-sum bounds for the quadratic twists. Both cross interface if-03 (WinPair / hostThickExists) into the cohomology component.",
            "key_insight": "This is a strict parameter order: choose L, then set base = 4Ld, then encode. Pick a smaller base and carries can create the relations that NoRel forbids.",
            "analogy_anchor": "A hash function whose bucket width is sized to the largest coefficient you will ever add, so that arithmetic on hashes is collision-free arithmetic on keys.",
            "loss_meter": {
              "fidelity_score": 0.7,
              "compression_ratio": "~5,000:1",
              "topology_status": "faithful_projection",
              "what_is_omitted": [
                "The internal proof steps (sphere_mem_lemma, coordinatewise digit extraction)",
                "Size and density of the resulting tower as a function of S, d, k",
                "The Lean statement of the prime-pair existence (QH.pairEx is named in the kicker but not pinned as a node in this capsule)",
                "Exact constants in the twisted prime-sum bounds"
              ],
              "where_metaphor_breaks": "The hash analogy suggests probabilistic collision avoidance. Here the avoidance is deterministic: it is proved for every admissible relation, not most of them, and it relies on the geometry of the sphere, which hashes don't have."
            }
          },
          "L3": {
            "title": "Behrend Spheres in Base 4Ld and Twist-Controlled Prime Pairs",
            "headline": "Strict convexity of Euclidean spheres together with carry-free radix encoding gives NoRel(L). Two auxiliary primes have √-bounded twisted prime sums.",
            "explanation": "Lattice points v on the Behrend sphere (fixed squared norm, bounded coordinates) are encoded as Σᵢ vᵢ(4Ld)ⁱ. Weighted combinations with coefficients ≤ L keep every digit below the base, so a relation among encodings lifts to the same relation coordinatewise in ℤᵈ. On the sphere this would put three distinct points on one affine line, which strict convexity forbids, since a line meets a sphere in at most two points. In parallel, the arithmetic stratum asks for two auxiliary primes in prescribed residue classes whose quadratic-twist prime sums satisfy square-root bounds. The remark (p. 4, entry 19) ties the tower choice to Behrend-type additive-combinatorial sets.",
            "key_insight": "Behrend's classical idea that spheres contain no 3-term progressions is generalised here to relations with weights i, j ≤ L. The base 4Ld is what makes the lift from ℕ to ℤᵈ exact.",
            "analogy_anchor": "Behrend's 1946 construction of large 3-AP-free sets, re-tuned for bounded-weight relations.",
            "loss_meter": {
              "fidelity_score": 0.9,
              "compression_ratio": "~200:1",
              "topology_status": "faithful_projection",
              "what_is_omitted": [
                "The verbatim definition of NoRel and the hypothesis hij/heq as stated in Lean",
                "The exact definitions of Behrend.sphere and Behrend.map in the module",
                "The analytic proof and precise statement of the auxiliary prime-pair bounds (not pinned in this capsule)"
              ],
              "where_metaphor_breaks": "The 3-AP-free analogy is only approximate. NoRel is a project-specific predicate with weights bounded by L and three distinct elements, and only its Lean definition fixes which relations are excluded."
            }
          },
          "L4": {
            "title": "Formal Anchor: ThickExists.noRel_image",
            "headline": "`Formalism.FrobeniusOrbits.ThickExists.noRel_image` (tier: checked) at commit 40e56bab026552e089d7afcfeff08d2defb9c005, lines 85–95.",
            "explanation": "Declaration: `lemma noRel_image (L S d k : ℕ) (hL : 1 ≤ L) : NoRel ((Behrend.sphere S d k).image (Behrend.map (4 * L * d))) L`, in module `Formalism.FrobeniusOrbits.FrobeniusOrbitsProofs.ThickExists` (Lean 4.33.1). The capsule's declared axiom footprint is the three standard axioms `propext`, `Classical.choice`, `Quot.sound`. The node `paper-behrend` is motivation only (https://alpo.ge/remark.pdf#page=4, entry 19), has no Lean declaration, and leaves through interface if-03 (WinPair / hostThickExists).",
            "key_insight": "Only `behrend` is a pinned, checked formal node in this component. QH.pairEx and hostThickExists appear as labels in the kicker and the interface, not as pinned nodes here.",
            "analogy_anchor": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Formalism/FrobeniusOrbits/FrobeniusOrbitsProofs/ThickExists.lean#L85-L95",
            "loss_meter": {
              "fidelity_score": 1.0,
              "compression_ratio": "1:1 (formal anchor)",
              "topology_status": "exact_isomorphism",
              "what_is_omitted": [],
              "where_metaphor_breaks": "Formalization Gap / Specification Boundary: the guarantee is only as strong as (1) trust in the Lean kernel and any independent replay, (2) the claim that the project definitions NoRel, Behrend.sphere and Behrend.map, plus the Mathlib Finset machinery, capture the intended mathematics, and (3) ongoing human peer review. The prime-pair claim and the paper's motivation node are not covered by this anchor."
            }
          }
        },
        "pl": {
          "L0": {
            "title": "Dwa pomocnicze klucze i kulki bez echa",
            "headline": "Zanim ruszy wielka maszyna, wybieramy dwa specjalne klucze i garść kulek, z których żadne trzy nigdy nie staną w jednym rzędzie.",
            "explanation": "Najpierw szukamy dwóch wyjątkowych liczb. Działają jak klucze do strojenia: każda musi trafić dokładnie w swoją nutę, a jej szum ma zostać cichy i nie może urosnąć w ryk. Potem wybieramy kulki z powierzchni piłki, bo prosty patyk dotknie skóry piłki najwyżej w dwóch miejscach, więc żadne trzy kulki nigdy nie leżą na jednej linii. Klucze i kulki wędrują dalej, do kolejnego warsztatu.",
            "key_insight": "Piłka jest okrągła, więc trzy różne punkty na jej powierzchni nigdy nie leżą na jednej prostej. To ta okrągłość sprawia, że wybór kulek jest bezpieczny.",
            "analogy_anchor": "Kulki przyklejone do dmuchanej piłki plażowej. Przebijasz piłkę prostym drutem i zawsze trafiasz najwyżej w dwie.",
            "loss_meter": {
              "fidelity_score": 0.2,
              "compression_ratio": "~500,000:1",
              "topology_status": "lossy_analogy",
              "what_is_omitted": [
                "To, że pomocnicze „klucze” są liczbami pierwszymi o zadanych kongruencjach",
                "Ograniczenia rzędu pierwiastka kwadratowego dla sum po liczbach pierwszych ich skręceń kwadratowych",
                "Kodowanie w podstawie 4Ld, które zamienia punkty sfery w pojedyncze liczby całkowite",
                "Dokładne znaczenie „żadnych trzech w rzędzie” (predykat NoRel ze współczynnikami ograniczonymi przez L)"
              ],
              "where_metaphor_breaks": "Prawdziwe kulki leżą w przestrzeni fizycznej. Rzeczywiste obiekty to liczby całkowite, a „ustawienie w rzędzie” oznacza spełnienie równania z małymi całkowitymi wagami, a nie dotknięcie drutu."
            }
          },
          "L1": {
            "title": "Nastrojone sondy i zbiór indeksów bez kolizji",
            "headline": "Dwie pomocnicze liczby pierwsze o kontrolowanym szumie i wieża indeksów zaprojektowana tak, by nie zaszedł żaden mały ważony zbieg okoliczności.",
            "explanation": "Warstwa arytmetyczna przygotowuje dwa surowce. Pierwszy to para pomocniczych liczb pierwszych o zadanych resztach, których skręcenia kwadratowe dają sumy po liczbach pierwszych nie większe niż rzędu pierwiastka, więc zachowują się jak szum, a nie sygnał. Drugi to wieża typu Behrenda: punkty sfery zapisane jako pojedyncze liczby w podstawie tak dużej, że dodawanie nie wywołuje przeniesień. Każdy zbieg okoliczności między tymi liczbami musiałby więc być zbiegiem między punktami sfery, a krzywizna sfery wyklucza go dla trzech różnych punktów.",
            "key_insight": "Duża podstawa nie pozwala cyfrom się mieszać, więc każde równanie rozpada się na osobne równanie dla każdej współrzędnej. Resztę załatwia krzywizna: prosta przecina sferę najwyżej w dwóch punktach.",
            "analogy_anchor": "Licznik kilometrów o ogromnie szerokich kółkach cyfr, w którym żadne kółko nie przeskakuje na sąsiednie, odczytujący punkty na idealnie okrągłym globusie.",
