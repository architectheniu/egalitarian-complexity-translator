        "contract": "An imprimitive character zero in 0<Re(s)<1 gives a zero of its primitive inducing character.",
        "idea": "Change level. Every removed prime factor has the form 1−χ(p)p^(−s), with the second term of norm less than one.",
        "assumptions": [
          "N and conductor nonzero",
          "0<Re(s)<1, L(s,χ)=0"
        ],
        "lean_head": "theorem prim_zero {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) [NeZero χ.conductor] {s : ℂ}\n    (hs0 : 0 < s.re) (hs1 : s.re < 1) (h : DirichletCharacter.LFunction χ s = 0) :\n    DirichletCharacter.LFunction χ.primitiveCharacter s = 0",
        "declaration": "Claim.prim_zero",
        "module": "Development.AutomorphicArithmetic.CharacterBoxes.ClaimStrip",
        "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Development/AutomorphicArithmetic/CharacterBoxes/ClaimStrip.lean#L23-L33",
        "excerpt": "theorem prim_zero {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) [NeZero χ.conductor] {s : ℂ}\n    (hs0 : 0 < s.re) (hs1 : s.re < 1) (h : DirichletCharacter.LFunction χ s = 0) :\n    DirichletCharacter.LFunction χ.primitiveCharacter s = 0 := by\n  have hs : s ≠ 1 := fun e => by rw [e, Complex.one_re] at hs1; exact lt_irrefl _ hs1\n  have key := DirichletCharacter.LFunction_changeLevel χ.conductor_dvd_level\n    χ.primitiveCharacter (Or.inr hs)\n  rw [χ.changeLevel_primitiveCharacter, h] at key\n  rcases mul_eq_zero.mp key.symm with h' | h'\n  · exact h'\n  · obtain ⟨p, hp, hp0⟩ := Finset.prod_eq_zero_iff.mp h'\n    exact absurd hp0 (factor_ne_zero _ hs0 p (Nat.prime_of_mem_primeFactors hp))",
