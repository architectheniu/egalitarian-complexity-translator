        "lean_head": "theorem vwin_of_counts (hP : GlobalTheory.Published.PoitouTateDuality) (hF : LocalFinitenessK) (hT : LocalTateDualityK) {CK : ℝ}\n    (hK : LemmaK CK) {K : BConst} (hB : ThmBab K 401) (hc : ThmBcFree) (h1 : CountI) (h2 : CountII) (h3 : CountIII)\n    (h5 : CountV) (hZ : CountZ) : VWin",
        "declaration": "UpperTheory.V.HV.vwin_of_counts",
