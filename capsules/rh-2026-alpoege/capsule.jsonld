        "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Formalism/GL3MeanSquares/HookFormulaTorsion/PsiZeroIntegral.lean#L530-L531",
        "excerpt": "theorem psi_zero_integral_constant : Formalism.HermitianLattices.GL2a2.PsiZeroConst := by\n  exact Formalism.HermitianLattices.P.PsiZeroIntegral.psiZeroConst_main",
