        "en": {
          "L0": {
            "title": "A master tuning and a test for every section: the whole orchestra plays clean",
            "statement": "Now there is not one orchestra but a whole family: one main orchestra and many sections with different colours. If one master tuning passes, and every section passes its own window test, then the main orchestra and every section play clean. A computer checked this \"if… then…\". Whether the tuning and the tests really pass, nobody has shown yet.",
            "intuition": "Two kinds of checks go together: one shared by everyone and one for each section. Clean sound for the whole family follows only from both at once.",
            "loss_meter": {
              "fidelity_score": 0.2,
              "compression_ratio": "~10^6:1",
              "topology_status": "lossy_analogy",
              "what_is_omitted": [
                "the formal content of the predicate TopG",
                "the formal content of VWinAt and the meaning of parameter 401",
