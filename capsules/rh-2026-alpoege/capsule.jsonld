        "pl": {
          "L0": {
            "title": "Pięć zamków w jednych drzwiach",
            "headline": "Na końcu poszukiwania skarbu pięć zamków mówi dokładnie, co znaleziono.",
            "explanation": "Na końcu długiego poszukiwania skarbu stoją drzwi z pięcioma zamkami, a przy każdym wisi tabliczka mówiąca dokładnie, czego strzeże. Dwa zamki strzegą najstarszej, najsłynniejszej tajemnicy; trzy pozostałe — całej rodziny pokrewnych tajemnic, po jednej na każdy możliwy rozmiar zamka. Wszystkie klucze wykuto w warsztacie za drzwiami — same drzwi sprawdzają tylko, czy klucz pasuje.",
            "key_insight": "Drzwi nie dodają żadnego nowego klucza; pokazują tylko prostymi słowami, co klucze otwierają.",
            "analogy_anchor": "Drzwi z pięcioma podpisanymi zamkami na końcu poszukiwania skarbu.",
            "loss_meter": {
              "fidelity_score": 0.2,
              "compression_ratio": "~500,000:1",
              "topology_status": "lossy_analogy",
              "what_is_omitted": [
                "Kto i jak wykuł klucze (cały wcześniejszy łańcuch dowodu, zakończony odbiciem)",
                "Co tajemnice mówią matematycznie (zera funkcji zeta i funkcji L Dirichleta leżą na prostej Re s = ½)",
                "Że dwa zamki otwiera dosłownie ten sam klucz (rhOfAll)"
              ],
              "where_metaphor_breaks": "Obracający się zamek pokazuje tylko, że klucz pasuje do kształtu; tutaj „pasowanie” oznacza sprawdzenie typów dowodu przez jądro względem twierdzenia z Mathlib, a to, czy tabliczka trafnie opisuje klasyczną tajemnicę, jest osobnym, ludzkim pytaniem."
            }
          },
          "L1": {
            "title": "Księga szczytowa",
            "headline": "Zwykła RH i GRH Dirichleta, zapisane dokładnie słowami, których używa świat.",
            "explanation": "Ten komponent nie dodaje nowej siły; to księga na szczycie, w której wyniki wpisuje się w oficjalnym brzmieniu. Zwykła RH pojawia się w sformułowaniu samego Mathlib i jeszcze raz w postaci rozwiniętej, a GRH Dirichleta na trzy sposoby: brak zer na prawo od ½, wszystkie zera w otwartym pasie na prostej oraz wersja dla charakterów prymitywnych. Wszystkie pięć to cienkie aliasy na wcześniejsze pakiety dowodowe (rhOfAll, allChi, claimAll, critAll).",
            "key_insight": "Zaufanie skupia się na sformułowaniach: jeśli definicje brzmią poprawnie, punkty końcowe znaczą to, co mówią.",
            "analogy_anchor": "Księga szczytowa z pięcioma wpisami podpisanymi przez kilka zespołów wspinaczy.",
