        "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Formalism/FrobeniusOrbits/FrobeniusOrbitsProofs/ThickExists.lean#L85-L95",
        "excerpt": "lemma noRel_image (L S d k : ℕ) (hL : 1 ≤ L) :\n    NoRel ((Behrend.sphere S d k).image (Behrend.map (4 * L * d))) L := by\n  unfold NoRel\n  intro s₁ hs₁ s₂ hs₂ s₃ hs₃ h12 h13 h23 i j hi0 hiL hj0 hjL hij heq\n  rw [Finset.mem_image] at hs₁ hs₂ hs₃\n  obtain ⟨v₁, hv₁, rfl⟩ := hs₁\n  obtain ⟨v₂, hv₂, rfl⟩ := hs₂\n  obtain ⟨v₃, hv₃, rfl⟩ := hs₃\n  obtain ⟨hb₁, hq₁⟩ := sphere_mem_lemma hv₁\n  obtain ⟨hb₂, hq₂⟩ := sphere_mem_lemma hv₂\n  obtain ⟨hb₃, hq₃⟩ := sphere_mem_lemma hv₃",
