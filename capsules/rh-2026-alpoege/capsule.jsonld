      {
        "id": "moment-majorant",
        "component": "statistic",
        "section": "context",
        "kind": "reducer",
        "title": "Dominate the centered character sum",
        "contract": "For each fixed character, the centered von Mangoldt sum is eventually bounded in norm by Kt/log²t.",
        "idea": "The Siegel–Walfisz estimate applies at a fixed modulus for all sufficiently large t. Exponential decay in the square root of log t implies the displayed inverse logarithmic factor.",
        "assumptions": [
          "A fixed positive modulus and a Dirichlet character."
        ],
        "lean_head": "private lemma sw_bound (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) : RemBound (fun n : ℕ => ((Λ n : ℝ) : ℂ) * χ (n : ZMod q)) (if χ = 1 then 1 else 0)",
        "declaration": "sw_bound",
        "module": "Formalism.GL3MeanSquares.HookFormulaTorsion.PsiZeroIntegral",
        "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Formalism/GL3MeanSquares/HookFormulaTorsion/PsiZeroIntegral.lean#L279-L301",
        "excerpt": "private lemma sw_bound (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) :\n    RemBound (fun n : ℕ => ((Λ n : ℝ) : ℂ) * χ (n : ZMod q)) (if χ = 1 then 1 else 0) := by\n  obtain ⟨c, C, hc, h⟩ := Formalism.ZeroFreeDirichlet.siegelWalfisz 1 one_pos\n  have hE : 0 < Real.exp (q : ℝ) := Real.exp_pos _\n  refine ⟨|C| * (24 / c ^ 4), Real.exp q + 2, by linarith, fun t ht => ?_⟩\n  have ht2 : 2 ≤ t := by linarith\n  have ht0 : 0 < t := by linarith\n  have hq : (q : ℝ) ≤ Real.log t ^ (1 : ℝ) := by\n    rw [Real.rpow_one, Real.le_log_iff_exp_le ht0]\n    linarith\n  have h1 := h q χ t ht2 hq\n  have e : rem (fun n : ℕ => ((Λ n : ℝ) : ℂ) * χ (n : ZMod q)) (if χ = 1 then 1 else 0) t =\n      Formalism.ZeroFreeDirichlet.psiChi χ t - (if χ = 1 then (t : ℂ) else 0) := by\n    unfold rem Formalism.ZeroFreeDirichlet.psiChi\n    split_ifs <;> simp\n  rw [e]\n  refine h1.trans ?_\n  have h2 := exp_sqrt_le hc (x := t) (by linarith)\n  calc C * t * Real.exp (-c * Real.sqrt (Real.log t))\n      ≤ |C| * t * (24 / c ^ 4 / Real.log t ^ 2) := by\n        gcongr\n        exact le_abs_self C\n    _ = |C| * (24 / c ^ 4) * t / Real.log t ^ 2 := by ring",
        "lines": [
          279,
          301
        ],
        "evidence": [
          "source-pin",
          "tree-pin"
        ],
        "tier": "covered"
      },
      {
        "id": "moment-dominated",
        "component": "statistic",
        "section": "context",
        "kind": "reducer",
        "title": "Pass the Mellin integral to σ = 1",
        "contract": "A logarithmic remainder bound lets σ times the weighted integral tend to its value at σ=1 from the right.",
        "idea": "The local integrand is measurable. A bound by the integrable error at σ=1 gives dominated convergence. The factor σ tends to one.",
        "assumptions": [
          "The explicit RemBound for the coefficients and their linear main term."
        ],
        "lean_head": "private lemma core_tendsto {a : ℕ → ℂ} {m : ℂ} (h : RemBound a m) : Tendsto (fun σ : ℝ => (σ : ℂ) * ∫ t in Set.Ioi (1 : ℝ), rem a m t * (t : ℂ) ^ (-((σ : ℂ) + 1))) (𝓝[>] 1) (𝓝 (∫ t in Set.Ioi (1 : ℝ), rem a m t * (t : ℂ) ^ (-(((1 : ℝ) : ℂ) + 1))))",
        "declaration": "core_tendsto",
        "module": "Formalism.GL3MeanSquares.HookFormulaTorsion.PsiZeroIntegral",
        "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Formalism/GL3MeanSquares/HookFormulaTorsion/PsiZeroIntegral.lean#L157-L176",
        "excerpt": "private lemma core_tendsto {a : ℕ → ℂ} {m : ℂ} (h : RemBound a m) :\n    Tendsto (fun σ : ℝ => (σ : ℂ) * ∫ t in Set.Ioi (1 : ℝ), rem a m t * (t : ℂ) ^ (-((σ : ℂ) + 1)))\n      (𝓝[>] 1) (𝓝 (∫ t in Set.Ioi (1 : ℝ), rem a m t * (t : ℂ) ^ (-(((1 : ℝ) : ℂ) + 1)))) := by\n  have hI : Tendsto (fun σ : ℝ => ∫ t in Set.Ioi (1 : ℝ), rem a m t * (t : ℂ) ^ (-((σ : ℂ) + 1)))\n      (𝓝[>] 1) (𝓝 (∫ t in Set.Ioi (1 : ℝ), rem a m t * (t : ℂ) ^ (-(((1 : ℝ) : ℂ) + 1)))) := by\n    refine tendsto_integral_filter_of_dominated_convergence\n      (fun t => ‖rem a m t * (t : ℂ) ^ (-(((1 : ℝ) : ℂ) + 1))‖) ?_ ?_ (core_integrable h).norm ?_\n    · exact Eventually.of_forall fun σ => (F_measurable a m _).aestronglyMeasurable\n    · filter_upwards [self_mem_nhdsWithin] with σ hσ\n      exact ae_restrict_of_forall_mem measurableSet_Ioi fun t ht => F_bound a m (le_of_lt hσ) ht\n    · refine ae_restrict_of_forall_mem measurableSet_Ioi fun t ht => ?_\n      have ht0 : (t : ℂ) ≠ 0 := by\n        have : (0 : ℝ) < t := lt_trans zero_lt_one ht\n        exact_mod_cast this.ne'\n      have hc : Continuous (fun σ : ℝ => rem a m t * (t : ℂ) ^ (-((σ : ℂ) + 1))) :=\n        continuous_const.mul (Continuous.const_cpow (by fun_prop) (Or.inl ht0))\n      exact (hc.tendsto 1).mono_left nhdsWithin_le_nhds\n  have hσ : Tendsto (fun σ : ℝ => (σ : ℂ)) (𝓝[>] 1) (𝓝 ((1 : ℝ) : ℂ)) :=\n    (Complex.continuous_ofReal.tendsto 1).mono_left nhdsWithin_le_nhds\n  simpa using hσ.mul hI",
        "lines": [
          157,
          176
        ],
