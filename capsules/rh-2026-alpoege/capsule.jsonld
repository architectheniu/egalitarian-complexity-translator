      {
        "id": "ch-core",
        "component": "comparison",
        "section": "windows",
        "kind": "reducer",
        "title": "Average over characters",
        "contract": "Under the size and character hypotheses, per-index discrepancy bounds imply a power bound for GmA up to SigA.",
        "idea": "Character orthogonality and scale estimates convert the indexed bounds into a weighted average.",
        "assumptions": [
          "growth and thin-scale estimates",
          "cost windows",
