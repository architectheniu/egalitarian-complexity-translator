        "pl": {
          "title": "Przeczytaj najpierw ostatnią stronę dowodu",
          "question": "Jak oszacowanie w prawej półpłaszczyźnie daje zwykłą hipotezę Riemanna?",
          "step_notes": [
            {
              "component_id": "endpoints",
              "note_by_level": {
                "L0": "Meta: wszystkie tajemnicze zera leżą na jednej prostej linii.",
                "L1": "Pięć punktów końcowych: zwykła RH w sformułowaniu Mathlib oraz GRH dla każdego charakteru Dirichleta każdego dodatniego modułu.",
                "L2": "Tylko wyjście. Wejście to twierdzenie o prostej krytycznej z odbicia (if-14).",
                "L3": "RH w sformułowaniu Mathlib i GRH Dirichleta dla wszystkich χ mod q, q ≥ 1.",
                "L4": "Węzły `main-rh`, `rh-all`. Krawędź `Claim.zeta · Claim.strip` (ClaimStrip.lean#L59-L100 @40e56ba)."
              }
            },
            {
              "component_id": "reflection",
              "note_by_level": {
                "L0": "Lustro: zero po lewej miałoby bliźniaka po prawej, a prawa strona jest już czysta.",
                "L1": "Dzięki symetrii odbicia wystarczy oczyścić półpłaszczyznę Re s > ½.",
                "L2": "Wejście: każde χ, Re s > ½ (if-13). Wyjście: prosta krytyczna (if-14).",
                "L3": "Równanie funkcyjne paruje zero ρ z 1−ρ (dla χ̄). Ponieważ objęte są wszystkie χ, brak zer dla Re s > ½ wymusza Re ρ = ½ w pasie krytycznym.",
                "L4": "Węzły `rh-every`, `rh-right`. Krawędź wejściowa `UpperTheory.Top.imprimitive` (Imprimitive.lean#L5-L35 @40e56ba)."
              }
            }
          ]
        },
        "en": {
          "title": "Read the last page of the proof first",
          "question": "How does a right-half-plane estimate imply ordinary RH?",
          "step_notes": [
            {
              "component_id": "endpoints",
              "note_by_level": {
                "L0": "The finish line: all the secret zeros sit on one straight line.",
                "L1": "Five endpoints: ordinary RH in Mathlib's own formulation, and GRH for every Dirichlet character of every positive modulus.",
                "L2": "Output only. The input is the critical-line statement from reflection (if-14).",
                "L3": "RH in Mathlib's formulation, plus Dirichlet GRH for all χ mod q, q ≥ 1.",
                "L4": "Nodes `main-rh`, `rh-all`. Edge `Claim.zeta · Claim.strip` (ClaimStrip.lean#L59-L100 @40e56ba)."
              }
            },
            {
              "component_id": "reflection",
              "note_by_level": {
                "L0": "A mirror: a zero on the left would have a twin on the right, and the right side is already clean.",
                "L1": "Because of reflection symmetry, clearing the half-plane Re s > ½ is enough.",
                "L2": "Input: every χ, Re s > ½ (if-13). Output: critical line (if-14).",
                "L3": "The functional equation pairs a zero ρ with 1−ρ (for χ̄). Since every χ is covered, zero-freeness for Re s > ½ forces Re ρ = ½ in the critical strip.",
                "L4": "Nodes `rh-every`, `rh-right`. Incoming edge `UpperTheory.Top.imprimitive` (Imprimitive.lean#L5-L35 @40e56ba)."
              }
            }
          ]
        }
      },
