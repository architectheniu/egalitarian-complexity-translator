      {
        "id": "tower-bound-from-rank",
        "component": "cohomology",
        "section": "cohomology",
        "kind": "reducer",
        "title": "From a finitely generated tower to two length bounds",
        "contract": "For each prime and eligible tower, ABound consists of a bound away from finitely many centres and a bound in terms of a fixed layer.",
        "idea": "Choose a Galois element generating the cyclotomic direction, prove the descent equality for its twists, and apply the two cokernel estimates on the tower module.",
        "assumptions": [
          "Global Poitou–Tate duality, local finiteness and local Tate duality",
          "A totally complex cyclotomic tower base with the prescribed roots and at most R generators"
        ],
        "lean_head": "theorem UpperTheory.V.PropA.aBound_of_isTower (hP : GlobalTheory.Published.PoitouTateDuality) (hF : LocalFinitenessK) (hT : LocalTateDualityK)\n    (l : ℕ) [Fact l.Prime] (L₀ : Type) [Field L₀] [NumberField L₀] (R : ℕ) (ht : UpperTheory.V.Tower.IsTower l L₀ R) :\n    UpperTheory.V.Win.ABound l R L₀",
        "declaration": "UpperTheory.V.PropA.aBound_of_isTower",
        "module": "Development.AutomorphicArithmetic.AutomorphicVarieties.AdditiveValuationNorms.ABoundOfIsTower",
        "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Development/AutomorphicArithmetic/AutomorphicVarieties/AdditiveValuationNorms/ABoundOfIsTower.lean#L7-L11",
        "excerpt": "theorem UpperTheory.V.PropA.aBound_of_isTower (hP : GlobalTheory.Published.PoitouTateDuality) (hF : LocalFinitenessK) (hT : LocalTateDualityK)\n    (l : ℕ) [Fact l.Prime] (L₀ : Type) [Field L₀] [NumberField L₀] (R : ℕ) (ht : UpperTheory.V.Tower.IsTower l L₀ R) :\n    UpperTheory.V.Win.ABound l R L₀ := by\n  obtain ⟨γ, h₁, h₂, h₃⟩ := UpperTheory.V.PropA.genLevel l L₀ ht.mu\n  exact UpperTheory.V.PropA.aBound_of_descends hP hF hT ht h₂ h₃ (UpperTheory.V.PropA.descends l L₀ ht.mu γ h₁)",
