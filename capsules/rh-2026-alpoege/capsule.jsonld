        "en": {
          "L0": {
            "title": "The Mirror Hall",
            "headline": "A wrong note on the left always echoes on the right.",
            "explanation": "Imagine a long hall with a mirror stripe painted down the middle. Whenever a bell rings in a wrong spot on the left side, the mirror makes a matching echo ring on the right side. So if you guard the right half and hear no bell there, the left half must be silent too.",
            "key_insight": "You only need to guard one half of the hall.",
            "analogy_anchor": "A hall with a mirror stripe down the middle, where every left-side bell has a right-side echo.",
            "loss_meter": {
              "fidelity_score": 0.2,
              "compression_ratio": "~500,000:1",
              "topology_status": "lossy_analogy",
              "what_is_omitted": [
