      {
        "id": "tower-operator-bound",
        "component": "cohomology",
        "section": "cohomology",
        "kind": "reducer",
        "title": "Control exceptional twists by the fixed layer",
        "contract": "The lengths are controlled by at most R ℓ-adic centres. For all twists they are also bounded by the fixed-layer H² length plus R times the excess layer index.",
        "idea": "Use unipotence modulo ℓ and the generator bound for the centres. The relative growth estimate can allow infinite length at a singular twist. Descent and duality bound the reference value by the arithmetic H² length.",
        "assumptions": [
          "Global Poitou–Tate duality, local finiteness and local Tate duality",
          "IsTower ℓ L₀ R",
          "A generator with the stated cyclotomic valuation, roots and descent identity"
        ],
        "lean_head": "theorem aBound_of_descends (hP : GlobalTheory.Published.PoitouTateDuality) (hF : LocalFinitenessK) (hT : LocalTateDualityK) {R c : ℕ}\n    (ht : IsTower l L₀ R) {γ : G L₀ (AlgebraicClosure L₀)} (hu : IsLevel l (cycZ L₀ _ l γ : ℤ_[l]) c)\n    (hc : ∃ ζ : L₀, IsPrimitiveRoot ζ (l ^ c)) (h : Descends l L₀ γ) : Win.ABound l R L₀",
        "declaration": "UpperTheory.V.PropA.aBound_of_descends",
        "module": "Development.AutomorphicArithmetic.AutomorphicVarieties.AdditiveValuationNorms.ABoundOfDescends",
        "url": "https://github.com/Deicyde/riemann-hypothesis/blob/40e56bab026552e089d7afcfeff08d2defb9c005/src/Development/AutomorphicArithmetic/AutomorphicVarieties/AdditiveValuationNorms/ABoundOfDescends.lean#L36-L55",
        "excerpt": "theorem aBound_of_descends (hP : GlobalTheory.Published.PoitouTateDuality) (hF : LocalFinitenessK) (hT : LocalTateDualityK) {R c : ℕ}\n    (ht : IsTower l L₀ R) {γ : G L₀ (AlgebraicClosure L₀)} (hu : IsLevel l (cycZ L₀ _ l γ : ℤ_[l]) c)\n    (hc : ∃ ζ : L₀, IsPrimitiveRoot ζ (l ^ c)) (h : Descends l L₀ γ) : Win.ABound l R L₀ := by\n  have hX : GenBy l R (XP l L₀) := ht.gen\n  have hγ := xUnip L₀ (AlgebraicClosure L₀) l l ⊤ isClosed_univ ht.gen.finite γ (mem_levU_one (lteNorm l _ c hu).2.1)\n  refine ⟨?_, fun e he m L₁ _ _ _ h₁ L₂ _ _ _ h₂ Ω _ _ _ D => ?_⟩\n  · obtain ⟨s, hs⟩ := exists_centres_norm hX hγ hu\n    refine ⟨ℚ_[l], inferInstance, inferInstance, inferInstance, c, R, fun i => s i, le_rfl, hc,\n      fun e he m L₁ _ _ _ h₁ B hB => ?_⟩\n    rw [h.eq_twLen he h₁]\n    refine hs e m B fun i => (hB i).trans (le_of_eq ?_)\n    rw [PadicInt.norm_def]\n    push_cast\n    rfl\n  · haveI := ht.complex\n    haveI : IsTotallyComplex L₂ := isTotallyComplex_of_algebra L₀ L₂\n    rw [h.eq_twLen he h₁]\n    refine (twLen_le_growth hX hγ hu e m).trans (add_le_add ?_ le_rfl)\n    rw [← h.eq_twLen he (m := jZero l R) h₂, ← shaLen_eq_shaInv D]\n    exact shaLeV hP hF hT L₂ Ω l (ptCase_of_isTotallyComplex L₂ l) D e",
